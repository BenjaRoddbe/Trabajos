	// FUNCIÓN DAR DE ALTA PROYECTO
	public void altaProyecto(int id, String curso, String nom, String tema, int anio, String autores, int ciAutores) {

		Proyecto p = new Proyecto(id, curso, nom, tema, anio, autores, ciAutores);
		listaProyectos.add(p);
	}

	// FUNCIÓN DE LISTAR PROYECTOS
	public void listarProyectos(DefaultTableModel modeloProyecto) {

		modeloProyecto.setRowCount(0);
		for (Proyecto p : listaProyectos) {

			Object[] fila = { p.getId(), p.getCurso(), p.getNom(), p.getTema(), p.getAño(), p.getAutores(),
					p.getCiAutores() };
			modeloProyecto.addRow(fila);
		}

	}

	// FUNCIÓN DAR DE ALTA AUTOR
	public void altaAutor(int ci, String primerNom, String primerApp) {

		Autor a = new Autor(ci, primerNom, primerApp);
		listaAutores.add(a);

	}

	// FUNCIÓN ALTA ADMIN
	public void altaAdmin(int ciAdmin, String contrasenia) {

		Admin ad = new Admin(ciAdmin, contrasenia);
		listaAdmins.add(ad);
	}

