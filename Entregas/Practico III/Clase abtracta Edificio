package pactico;

public abstract class Edificio {

	private int id;
	private String calle;

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getCalle() {
		return calle;
	}

	public void setCalle(String calle) {
		this.calle = calle;
	}

	public Edificio(int id, String calle) {
		super();
		this.id = id;
		this.calle = calle;
	}

 }
