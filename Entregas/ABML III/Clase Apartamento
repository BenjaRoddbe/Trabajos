package abml3;

public class Apartamento extends Edificio {

	private int nroApartamentos;
	private int nroHabitantes;

	public int getNroApartamentos() {
		return nroApartamentos;
	}

	public void setNroApartamentos(int nroApartamentos) {
		this.nroApartamentos = nroApartamentos;
	}

	public int getNroHabitantes() {
		return nroHabitantes;
	}

	public void setNroHabitantes(int nroHabitantes) {
		this.nroHabitantes = nroHabitantes;
	}

	public Apartamento(int id, String calle, int nroApartamentos, int nroHabitantes) {
		super(id, calle);
		this.nroApartamentos = nroApartamentos;
		this.nroHabitantes = nroHabitantes;
	}

}
