package practicoII;

public abstract class Publicacion {

	private int id;
	private String autor;

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getAutor() {
		return autor;
	}

	public void setAutor(String autor) {
		this.autor = autor;
	}

	public Publicacion(int id, String autor) {
		super();
		this.id = id;
		this.autor = autor;
	}

}
