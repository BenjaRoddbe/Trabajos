package Mercado;

public abstract class Producto {

	private int id;
	private String marca;
	

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getMarca() {
		return marca;
	}

	public void setMarca(String marca) {
		this.marca = marca;
	}

	public Producto(int id, String marca) {
		super();
		this.id = id;
		this.marca = marca;
	}

	

}
