	public static boolean chequearExistenciaElec(Electronica[] a, int id) {

		boolean existe = false;
		for (int i = 0; i < a.length; i++) {
			if (a[i] != null && a[i].getId() == id) {

				existe = true;
				System.out.println("Ya existe un producto con ese id");
				break;
			}
		}
		return existe;
	}

