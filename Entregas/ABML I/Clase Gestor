		Scanner entrada = new Scanner(System.in);
		int id = 0;
		for (int i = 0; i < a.length; i++) {
			if (a[i] != null) {
				if (datoModif == 1 && !chequearExistenciaElec(a, id)) {
					a[i].setId(idN);
				}
				if (datoModif == 2) {
					a[i].setNom(nomN);
				}
				if (datoModif == 3) {
					a[i].setAñoFabri(añofN);
				}
				if (datoModif == 4) {
					a[i].setTamaño(tamN);
				}
			}
		}

	}
	
