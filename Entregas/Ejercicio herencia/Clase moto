package practicoiii;

public class Moto extends Vehiculo {

	private int ide;
	private String color;
	private String model;

	public int getIde() {
		return ide;
	}

	public void setIde(int ide) {
		this.ide = ide;
	}

	public String getColor() {
		return color;
	}

	public void setColor(String color) {
		this.color = color;
	}

	public String getModel() {
		return model;
	}

	public void setModel(String model) {
		this.model = model;
	}

	public Moto(String modelo, int id, int nroMotor, int ide, String color, String model) {
		super(modelo, id, nroMotor);
		this.ide = ide;
		this.color = color;
		this.model = model;
	}

}
